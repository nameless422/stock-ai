REMOTE_HOST=your.server.ip
REMOTE_USER=ubuntu
REMOTE_PORT=22
REMOTE_APP_DIR=/home/ubuntu/stock-ai
APP_USER=ubuntu
SERVER_PUBLIC_IP=your.server.ip

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=stock_ai
MYSQL_APP_USER=stock_ai
MYSQL_APP_PASSWORD=your_strong_password

STOCK_AI_DB_URL=mysql://stock_ai:your_strong_password@127.0.0.1:3306/stock_ai?charset=utf8mb4

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
ASSISTANT_CHAT_MODELS=deepseek-v4-flash,deepseek-v4-pro
ASSISTANT_ASR_BACKEND=whispercpp
ASSISTANT_ASR_LANGUAGE=zh
WHISPER_CPP_MODEL_NAME=base
ENABLE_SELF_SIGNED_HTTPS=1

# Optional
# REMOTE_PASSWORD=your_server_password
# MYSQL_ROOT_PASSWORD=your_mysql_root_password
# DEEPSEEK_API_BASE=https://api.deepseek.com
# OPENAI_API_KEY=your_openai_api_key
